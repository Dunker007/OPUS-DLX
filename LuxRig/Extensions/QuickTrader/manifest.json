{
  "manifest_version": 3,
  "name": "LuxRig QuickTrader",
  "version": "1.0.0",
  "description": "Quick crypto trading from your browser - instant portfolio, prices, and trades",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.coinbase.com/*",
    "https://api.binance.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
